{
  "name": "@meshsdk/x402",
  "version": "0.0.1",
  "description": "x402 payments (Cardano exact scheme) - https://meshjs.dev/apis/x402",
  "license": "Apache-2.0",
  "homepage": "https://meshjs.dev/apis/x402",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeshJS/Mesh-x402.git"
  },
  "bugs": {
    "url": "https://github.com/MeshJS/Mesh-x402/issues"
  },
  "main": "./dist/index.cjs",
  "browser": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "tsc --noEmit",
    "pack": "npm pack --pack-destination=./dist",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@harmoniclabs/cbor": "1.6.0",
    "@harmoniclabs/plutus-data": "1.2.6",
    "@meshsdk/common": "1.9.1",
    "@meshsdk/core-cst": "1.9.1",
    "@meshsdk/transaction": "1.9.1",
    "@meshsdk/wallet": "1.9.1",
    "@noble/hashes": "^1.5.0",
    "hono": "^4.6.0",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@meshsdk/core": "1.9.1",
    "@meshsdk/provider": "^1.9.0-beta.105",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "prettier": "^3.3.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cardano",
    "ada",
    "web3",
    "blockchain",
    "sdk",
    "x402",
    "payments"
  ]
}
